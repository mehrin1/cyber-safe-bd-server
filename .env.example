# Production client origin. Do not include a trailing slash.
APP_URL=https://cyber-crime-bd-client.vercel.app
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-64-character-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional: the designated account is promoted after its first successful login.
BOOTSTRAP_ADMIN_EMAIL=faysalahmed915@gmail.com

# Server-only Gemini API configuration for the retrieval-augmented chat assistant.
# Get a free, rate-limited key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
