generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  role          UserRole         @default(USER)
  status        UserStatus       @default(ACTIVE)
  phone         String?
  sessions      Session[]
  accounts      Account[]
  helpRequests  HelpRequest[]
  sentMessages  HelpMessage[]
  surveyResponses SurveyResponse[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model LearnCategory {
  id          String    @id
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id          String        @id @default(uuid())
  title       String
  summary     String
  content     String        @db.Text
  tips        String[]
  cases       String[]
  categoryId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    LearnCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
}

model Law {
  id               String               @id @default(uuid())
  slug             String               @unique @default(uuid())
  title            String
  description      String               @db.Text
  region           LawRegion
  category         LawCategory
  authority        String
  publishedDate    String
  status           LawStatus            @default(IN_FORCE)
  legalTopics      String[]             @default([])
  applicability    String[]             @default([])
  source           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  crimeReferences  CrimeLawReference[]

  @@index([region, category])
  @@index([status])
}

model CrimeType {
  id                String              @id @default(uuid())
  slug              String              @unique
  name              String
  description       String              @db.Text
  category          String
  subtypes          String[]            @default([])
  immediateSteps    String[]            @default([])
  evidenceChecklist String[]            @default([])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  legalReferences   CrimeLawReference[]

  @@index([category])
}

model CrimeLawReference {
  id                 String      @id @default(uuid())
  crimeTypeId        String
  lawId              String
  guidance           String      @db.Text
  relevantProvisions String[]    @default([])
  crimeType          CrimeType   @relation(fields: [crimeTypeId], references: [id], onDelete: Cascade)
  law                Law         @relation(fields: [lawId], references: [id], onDelete: Cascade)

  @@unique([crimeTypeId, lawId])
  @@index([lawId])
}

model Professional {
  id           String             @id @default(uuid())
  name         String
  role         ProfessionalRole
  designation  String
  organization String
  verified     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  advices      Advice[]

  @@index([role, verified])
}

model Advice {
  id             String       @id @default(uuid())
  title          String
  content        String       @db.Text
  category       String
  professionalId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, category])
}

model SupportResource {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String   @db.Text
  region           String
  serviceType      String
  urgency          String   @default("GUIDANCE")
  contactLabel     String
  contactValue     String
  contactUrl       String?
  availability     String?
  languages        String[] @default([])
  eligibility      String?
  isOfficial       Boolean  @default(true)
  sourceUrl        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([region, serviceType])
  @@index([urgency])
}

model HelpRequest {
  id          String             @id @default(uuid())
  title       String
  description String             @db.Text
  category    HelpCategory
  isAnonymous Boolean            @default(false)
  status      HelpRequestStatus  @default(PENDING)
  userId      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    HelpMessage[]

  @@index([category, status])
}

model HelpMessage {
  id            String        @id @default(uuid())
  helpRequestId String
  senderType    MessageSender
  text          String        @db.Text
  senderId      String?
  createdAt     DateTime      @default(now())
  helpRequest   HelpRequest   @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  sender        User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([helpRequestId, createdAt])
}

model Survey {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  description String?          @db.Text
  version     Int              @default(1)
  isPublished Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sections    SurveySection[]
  responses   SurveyResponse[]

  @@index([isPublished])
}

model SurveySection {
  id          String           @id @default(uuid())
  surveyId    String
  key         String
  title       String
  description String?          @db.Text
  order       Int
  metadata    Json?
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions   SurveyQuestion[]

  @@unique([surveyId, key])
  @@index([surveyId, order])
}

model SurveyQuestion {
  id          String             @id @default(uuid())
  sectionId   String
  key         String
  externalId  String?
  prompt      String             @db.Text
  description String?            @db.Text
  type        SurveyQuestionType
  isRequired  Boolean            @default(false)
  order       Int
  config      Json?
  section     SurveySection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options     SurveyOption[]
  answers     SurveyAnswer[]

  @@unique([sectionId, key])
  @@index([sectionId, order])
  @@index([externalId])
}

model SurveyOption {
  id          String         @id @default(uuid())
  questionId  String
  value       String
  label       String
  order       Int
  metadata    Json?
  question    SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
  @@index([questionId, order])
}

model SurveyResponse {
  id          String          @id @default(uuid())
  surveyId    String
  userId      String?
  status      SurveyResponseStatus @default(COMPLETED)
  metadata    Json?
  submittedAt DateTime        @default(now())
  survey      Survey          @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers     SurveyAnswer[]

  @@index([surveyId, submittedAt])
  @@index([userId, submittedAt])
}

model SurveyAnswer {
  id             String          @id @default(uuid())
  responseId     String
  questionId     String
  textValue      String?         @db.Text
  numberValue    Int?
  selectedValues String[]
  selectedLabels String[]        @default([])
  displayValue   String          @default("") @db.Text
  value          Json
  response       SurveyResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question       SurveyQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId, numberValue])
  @@index([questionId])
}

enum UserRole {
  USER
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum LawRegion {
  BANGLADESH
  INTERNATIONAL
}

enum LawCategory {
  CYBERCRIME
  DATA_PROTECTION
  HARASSMENT
  FINANCIAL
  ELECTRONIC_EVIDENCE
  TELECOMMUNICATIONS
  CHILD_PROTECTION
  INTELLECTUAL_PROPERTY
  INTERNATIONAL_COOPERATION
  PLATFORM_GOVERNANCE
}

enum LawStatus {
  IN_FORCE
  REFERENCE
  SUPERSEDED
  NOT_IN_FORCE
}

enum ProfessionalRole {
  POLICE
  LAWYER
  PSYCHOLOGIST
  HUMAN_RIGHTS
  ETHICAL_HACKER
}

enum HelpCategory {
  LEGAL
  MENTAL
  EMERGENCY
  ACCOUNT_SECURITY
  ONLINE_HARASSMENT
  FINANCIAL_FRAUD
  IMAGE_ABUSE
  CHILD_SAFETY
}

enum HelpRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageSender {
  USER
  PROFESSIONAL
}

enum SurveyQuestionType {
  SHORT_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
}

enum SurveyResponseStatus {
  COMPLETED
  DISCARDED
}
